# Custom project rules
# Ensure the sample_openapi_files directory itself is NOT ignored by default.
# The .gitkeep file ensures it's tracked even if empty initially.
!/openapi_agentic_converter/sample_openapi_files/
!/openapi_agentic_converter/sample_openapi_files/.gitkeep
# Example for ignoring specific subdirectories like output:
# /openapi_agentic_converter/sample_openapi_files/output/*

# Ensure test files and __init__.py are not ignored
!/openapi_agentic_converter/tests/*
!/openapi_agentic_converter/tests/.gitkeep
!/openapi_agentic_converter/tests/__init__.py

# Ensure agent and util __init__.py are not ignored
!/openapi_agentic_converter/src/agents/__init__.py
!/openapi_agentic_converter/src/utils/__init__.py

# General log files (if not covered by specific tool logs above)
*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temp files
*.tmp
*.bak
*.swp
*~
